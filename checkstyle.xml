<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Checkstyle 配置文件，用于强制 Java 代码规范，基于 Google Java Style 但更严格 -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>   <!-- 不满足规则视为错误 -->
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- 禁止使用 Tab 键缩进，必须用空格 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 单个文件最大行数 2000 -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <!-- 禁止行尾有空白字符 -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>

    <!-- TreeWalker 逐行检查代码 -->
    <module name="TreeWalker">
        <!-- 命名规范：类、接口大驼峰 -->
        <module name="TypeName"/>
        <!-- 方法名小驼峰 -->
        <module name="MethodName"/>
        <!-- 成员变量小驼峰 -->
        <module name="MemberName"/>
        <!-- 参数名小驼峰 -->
        <module name="ParameterName"/>
        <!-- 局部变量小驼峰 -->
        <module name="LocalVariableName"/>
        <!-- 常量全大写加下划线 -->
        <module name="ConstantName"/>

        <!-- 缩进：4 个空格 -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
        </module>

        <!-- 每行最大长度 120 字符，忽略包导入和超链接 -->
        <module name="LineLength">
            <property name="max" value="120"/>
            <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
        </module>

        <!-- 公共方法必须有 Javadoc 注释 -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
        </module>
        <!-- 公共类、接口必须有 Javadoc 注释 -->
        <module name="JavadocType"/>

        <!-- 禁止使用星号（*）导入，必须明确导入类 -->
        <module name="AvoidStarImport"/>
        <!-- 检测无用的导入 -->
        <module name="UnusedImports"/>
        <!-- 导入顺序：java, javax, org, com -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
        </module>

        <!-- 单个方法最多 30 行代码（不含括号） -->
        <module name="MethodLength">
            <property name="tokens" value="METHOD_DEF"/>
            <property name="max" value="30"/>
        </module>

        <!-- 方法参数不超过 5 个 -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
        </module>

        <!-- 空的 catch 块必须有注释说明原因 -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>

        <!-- 避免多余的修饰符（例如接口方法不需要 public） -->
        <module name="RedundantModifier"/>

        <!-- 禁止使用 System.out.println，应使用日志框架 -->
        <module name="Regexp">
            <property name="format" value="System\.out\.println"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Avoid using System.out.println, use logging instead."/>
        </module>
    </module>
</module>