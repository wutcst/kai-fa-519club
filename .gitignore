# 注释：该文件告诉 Git 哪些文件/目录不需要提交到仓库

# 编译生成的文件
target/
*.class

# Maven 临时文件
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# IDE 配置文件（IntelliJ IDEA）
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.swp
*.swo

# 日志文件
*.log

# 操作系统生成的文件
.DS_Store
Thumbs.db

# 本地配置文件（包含敏感信息）
application-local.properties
secret.properties

# 实训报告：提交 REPORT.pdf 或 REPORT.docx 到仓库（不要忽略）