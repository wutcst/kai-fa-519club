# 复制本文件为 application-local.properties（项目根目录或 src/main/resources）
# application-local.properties 已在 .gitignore 中，不会提交密码。

# ---------- QQ 邮箱示例 ----------
# 1. 登录 QQ 邮箱 → 设置 → 账户 → 开启 SMTP → 生成「授权码」
# 2. spring.mail.password 填授权码，不是 QQ 登录密码
# spring.mail.host=smtp.qq.com
# spring.mail.port=587
# spring.mail.username=你的QQ号@qq.com
# spring.mail.password=你的16位授权码
# spring.mail.properties.mail.smtp.ssl.trust=smtp.qq.com
# zuul.mail.from=你的QQ号@qq.com

# ---------- 163 邮箱示例 ----------
# spring.mail.host=smtp.163.com
# spring.mail.port=465
# spring.mail.username=你的邮箱@163.com
# spring.mail.password=客户端授权密码
# spring.mail.properties.mail.smtp.ssl.enable=true
# spring.mail.properties.mail.smtp.ssl.trust=smtp.163.com
# zuul.mail.from=你的邮箱@163.com

# 填写后取消下面几行的注释并改成你的信息：
# spring.mail.host=smtp.qq.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.ssl.trust=smtp.qq.com
# zuul.mail.from=
